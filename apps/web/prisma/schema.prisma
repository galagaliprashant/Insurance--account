// Protection Passport — claim-assist persistence layer.
// Everything else in the app (protections, family, dashboard) stays
// mock-data-first per the PRD; this schema backs only the genuinely
// stateful mobile flow: accounts, KYC, discovery runs, and tickets
// that must be looked up later by ticket number.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())

  cases Case[]

  @@map("users")
}

enum CaseStatus {
  OPEN
  KYC_PENDING
  KYC_VERIFIED
  DISCOVERY_COMPLETE
  CLOSED
}

model Case {
  id                      String     @id @default(cuid())
  userId                  String
  user                    User       @relation(fields: [userId], references: [id])
  deceasedName            String
  deceasedDob             DateTime
  dateOfDemise            DateTime
  relationshipToClaimant  String
  deceasedPanMasked       String?
  deceasedAadhaarMasked   String?
  status                  CaseStatus @default(OPEN)
  createdAt               DateTime   @default(now())

  kycRecord     KycRecord?
  discoveryRuns DiscoveryRun[]
  tickets       Ticket[]

  @@map("cases")
}

enum KycStepState {
  PENDING
  OTP_SENT
  VERIFIED
  FAILED
}

model KycRecord {
  id              String       @id @default(cuid())
  caseId          String       @unique
  case            Case         @relation(fields: [caseId], references: [id])
  aadhaarMasked   String?
  aadhaarState    KycStepState @default(PENDING)
  // Demo mode only: never store a real OTP in plaintext in production.
  demoOtpCode     String?
  otpSentAt       DateTime?
  otpVerifiedAt   DateTime?
  panNumberMasked String?
  panState        KycStepState @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("kyc_records")
}

enum DiscoveryStatus {
  PROCESSING
  COMPLETE
}

model DiscoveryRun {
  id                 String          @id @default(cuid())
  caseId             String
  case               Case            @relation(fields: [caseId], references: [id])
  status             DiscoveryStatus @default(PROCESSING)
  // IDs/types reference the static demo protection dataset, not DB rows —
  // stored as JSON text so the schema stays portable (no native array column).
  matchedProtectionIdsJson String     @default("[]")
  missingTypesJson         String     @default("[]")
  ranAt              DateTime        @default(now())
  completedAt        DateTime?

  @@map("discovery_runs")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Ticket {
  id               String       @id @default(cuid())
  ticketNumber     String       @unique
  caseId           String
  case             Case         @relation(fields: [caseId], references: [id])
  missingItemType  String
  description      String
  status           TicketStatus @default(OPEN)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("tickets")
}

// Monotonic sequence backing human-readable ticket numbers (PP-2026-000123),
// so numbering survives across serverless invocations.
model TicketSequence {
  year     Int @id
  lastSeq  Int @default(0)

  @@map("ticket_sequences")
}
