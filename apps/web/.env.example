# Postgres connection string for the claim-assist persistence layer
# (users, cases, KYC status, tickets). In production, connect a Postgres
# store from the Vercel dashboard (Storage tab -> Postgres/Neon) and it
# will populate DATABASE_URL automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/protection_passport"

# Secret used to sign claimant session JWTs. Generate with:
#   openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-value"
